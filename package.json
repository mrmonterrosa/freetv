{
  "name": "freetv",
  "version": "1.0.0",
  "homepage": "https://mrmonterrosa.github.io/freetv",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "dev": "ng serve --open",
    "serve": "ng serve",
    "build": "ng build",
    "build:gh": "ng build --base-href=/freetv/",
    "predeploy": "npm run build:gh && node -e \"require('fs').copyFileSync('dist/freetv/index.html', 'dist/freetv/404.html')\"",
    "deploy": "gh-pages -d dist/freetv -b gh-pages"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "hls.js": "^1.5.17",
    "iptv-playlist-parser": "^0.13.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@types/jasmine": "~5.1.7",
    "angular-cli-ghpages": "^3.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
